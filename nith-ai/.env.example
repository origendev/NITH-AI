# Base URL of your FastAPI backend (no trailing slash).
# The frontend calls POST {VITE_API_BASE_URL}/api/chat
#
# Leave it EMPTY to use same-origin requests (/api/chat). In `npm run dev`
# Vite then proxies /api/* to VITE_DEV_PROXY_TARGET, so no CORS setup is needed.
VITE_API_BASE_URL=http://localhost:8000

# Only used by the dev server when VITE_API_BASE_URL is empty.
# VITE_DEV_PROXY_TARGET=http://localhost:8000
