# Copy this file to ".env" in the same folder and fill in your key.
# NEVER commit .env or paste the key into the frontend.

# Get a key at https://build.nvidia.com (starts with "nvapi-")
NVIDIA_API_KEY=nvapi-PASTE_YOUR_KEY_HERE

# Any chat model id from https://build.nvidia.com/models (copy it from the model's code sample)
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Where your React app runs (comma separated). Add your deployed site URL here later.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional tuning
# MAX_TOKENS=2048
# TEMPERATURE=0.6
